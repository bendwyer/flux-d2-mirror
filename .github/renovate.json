{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": false,
  "prHourlyLimit": 0,
  "labels": ["dependencies"],
  "rebaseWhen": "behind-base-branch",
  "separateMinorPatch": true,
  "github-actions": { "enabled": false },
  "customManagers": [
    {
      "description": "Flux Mirror CLI version passed to the reusable workflow. Dependabot bumps the action pin in github-workflows but cannot update an input value.",
      "customType": "regex",
      "managerFilePatterns": ["/\\.github/workflows/.+\\.yml$/"],
      "matchStrings": ["mirror_version:\\s+\"?(?<currentValue>v[^\"\\s]+)\"?"],
      "depNameTemplate": "fluxcd/flux-mirror",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "description": "Flux Mirror is preview software, so review every bump.",
      "matchPackageNames": ["fluxcd/flux-mirror"],
      "automerge": false
    }
  ]
}
